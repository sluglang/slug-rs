/**
 * slug.text.markdown — Markdown to safe HTML
 *
 * `toHtml(source, options)` renders Markdown as an HTML fragment that is
 * safe to place in a page: it holds only the elements and attributes listed
 * below, every text and attribute value is escaped, and every link and image
 * URL has passed the policy's allowlist.
 *
 * ```slug
 * val markdown = import("slug.text.markdown")
 *
 * markdown.toHtml("# Notes\n\nSee *the* [guide](/guide).")
 * // <h1>Notes</h1>\n<p>See <em>the</em> <a href="/guide">guide</a>.</p>\n
 * ```
 *
 * The dialect is CommonMark 0.31.2 with GitHub's tables, strikethrough
 * (`~one~` or `~~two~~` tildes), and extended autolinks (`www.`, `http://`,
 * `https://`, and `ftp://` links, `mailto:` and `xmpp:` addresses, and email
 * addresses, in text outside links), with one change: raw
 * HTML is not HTML. A line that would start an HTML block is paragraph
 * text, and an inline tag, comment, or declaration is shown as the text it
 * is, escaped, with no Markdown read inside it. Code spans and code blocks
 * are always escaped text.
 *
 * The output uses only `p`, `h1`–`h6` (`id` only when assigned in a typed
 * tree), `blockquote`, `ul`, `ol` (`start`),
 * `li`, `pre`, `code` (`class="language-…"` on a fenced block's), `hr`,
 * `br`, `em`, `strong`, `del`, `a` (`href`, `title`, `rel`), `img` (`src`,
 * `alt`, `title`), `table`, `thead`, `tbody`, `tr`, `th` and `td` (`align`).
 * Text is escaped for `&`, `<`, `>`, and `"`; a URL is percent-encoded
 * outside a safe set of characters, with `&` and `'` escaped as well.
 *
 * Link and image URLs are classified after Markdown's escapes and entities
 * are resolved, as a browser would read them: leading and trailing control
 * characters and spaces are removed, and tabs and line endings anywhere,
 * and then the scheme is the letters, digits, `+`, `-`, and `.` before the
 * first `:`, if the first is a letter, lowercased. A URL with another control
 * character is refused. A URL with no scheme is `relative`, unless it starts
 * with two slashes or backslashes, which make it a network-path reference
 * to another host: allowed only where both `http` and `https` are. A link
 * whose URL the policy refuses is rendered as its text, and an image as its
 * description. A link inside a link is rendered as its text.
 *
 * Options, all optional:
 *
 * - `links`: the schemes links may use, and `"relative"` for relative URLs;
 *   default `["relative", "http", "https", "mailto"]`.
 * - `images`: the same for images; default `["relative"]`, so a page does
 *   not fetch images from other hosts. `[]` shows every image as its
 *   description.
 * - `rel`: a `rel` attribute for links that are not relative, such as
 *   `"nofollow noopener"`; default none.
 * - `maxBytes`: the most UTF-8 bytes the source may have; default 65536.
 * - `maxDepth`: how deep blocks (block quotes, lists, and items) and,
 *   separately, inline elements (emphasis, links, and strikethrough) may
 *   nest; default 32.
 *
 * `javascript`, `vbscript`, `data`, and `file` are never allowed. An unknown
 * option or a bad value throws a `markdown.options` error. Source over
 * `maxBytes`, or nesting deeper than `maxDepth`, throws a `markdown.limit`
 * error whose `data` is `{limit: "bytes"|"depth", max}`. Every other input
 * renders; the parser's time is linear in the source's length.
 *
 * Rendering reads nothing but its arguments: no files, network, or clock.
 * The source is not changed; the HTML is a view of it.
 *
 * `parse` returns a fully parsed typed `Document`; `transform` replaces nodes
 * post-order, `render` safely renders constructed or transformed trees, and
 * `toText` extracts decoded text. `Node` is a payload enum. `Document`,
 * `Position`, and `Span` are record types with matching struct constructors.
 * See docs/reference/markdown-documents.md for fields, provenance, and limits.
 */

val {join, split, toBytes, lower, chr} = import("slug.string")
val bytes = import("slug.bytes")
val {parseBlocks} = import("slug.text.markdown.block")
val {parseInlines, isAlpha, isAlnum} = import("slug.text.markdown.inline")
val {map} = import("slug.std")

// --- Options -----------------------------------------------------------------

val DEFAULTS = {
    links: ["relative", "http", "https", "mailto"],
    images: ["relative"],
    rel: "",
    maxBytes: 65536,
    maxDepth: 32,
}

val NEVER = {javascript: true, vbscript: true, data: true, file: true}

val optionsError = fn(message:str) {
    throw Error {type: "markdown.options", msg: message}
}

val isScheme = fn(name:str):bool {
    val go = fn(i:num):bool {
        if (i >= len(name)) { return true }
        val c = name[i]
        if ((c >= "a" && c <= "z") || (c >= "0" && c <= "9") || c == "+" || c == "-" || c == ".") { recur(i + 1) } else { false }
    }
    len(name) > 0 && name[0] >= "a" && name[0] <= "z" && go(0)
}

// A list of allowed schemes as a set.
val schemeSet = fn(name:str, value):map {
    match value {
        names:list => {
            val go = fn(i:num, out:map):map {
                if (i >= len(names)) { return out }
                val scheme = match names[i] {
                    s:str => s
                    _ => optionsError("`$name` must be a list of strings")
                }
                if (scheme != "relative" && !isScheme(scheme)) { optionsError("`$name` has `$scheme`, which is not a lowercase scheme") }
                if (NEVER[scheme] == true) { optionsError("`$name` may not allow `$scheme`") }
                recur(i + 1, out + {[scheme]: true})
            }
            go(0, {})
        }
        _ => optionsError("`$name` must be a list of strings")
    }
}

val isWholeNumber = fn(value):bool {
    match value {
        n:num => n >= 1 && int(n) == n
        _ => false
    }
}

val checkOptions = fn(options:map):map {
    val names = keys(options)
    val unknown = fn(i:num) {
        if (i < len(names)) {
            val name = names[i]
            if (DEFAULTS[name] == nil) { optionsError("unknown option `$name`") }
            recur(i + 1)
        }
    }
    unknown(0)
    val o = DEFAULTS + options
    val rel = match o.rel {
        r:str => r
        _ => optionsError("`rel` must be a string")
    }
    val relOk = fn(i:num):bool {
        if (i >= len(rel)) { return true }
        val c = rel[i]
        if ((c >= "a" && c <= "z") || c == " " || c == "-") { recur(i + 1) } else { false }
    }
    if (!relOk(0)) { optionsError("`rel` may hold only lowercase letters, `-`, and spaces") }
    if (!isWholeNumber(o.maxBytes)) { optionsError("`maxBytes` must be a positive integer") }
    if (!isWholeNumber(o.maxDepth)) { optionsError("`maxDepth` must be a positive integer") }
    {links: schemeSet("links", o.links), images: schemeSet("images", o.images), rel: rel, maxBytes: o.maxBytes, maxDepth: o.maxDepth}
}

// --- URLs --------------------------------------------------------------------

// How a browser would read `url`'s kind: a lowercase scheme, "relative",
// "network" for `//host`, or "" for a URL refused outright.
val urlKind = fn(url:str):str {
    val n = len(url)
    val first = fn(i:num):num { if (i < n && url[i] <= " ") { recur(i + 1) } else { i } }
    val last = fn(i:num):num { if (i > 0 && url[i - 1] <= " ") { recur(i - 1) } else { i } }
    val start = first(0)
    val end = last(n)
    // Without tabs and line endings; another control character refuses it.
    val clean = fn(i:num, out:str) {
        if (i >= end) { return out }
        val c = url[i]
        if (c == "\t" || c == "\n" || c == "\r") { return recur(i + 1, out) }
        if (c < " " || c == "\177") { return nil }
        recur(i + 1, out + c)
    }
    val cleaned = clean(start, "")
    if (cleaned == nil) { return "" }
    val t:str = cleaned
    val scheme = fn(i:num):num {
        if (i < len(t) && (isAlnum(t[i]) || t[i] == "+" || t[i] == "-" || t[i] == ".")) { recur(i + 1) } else { i }
    }
    if (len(t) > 0 && isAlpha(t[0])) {
        val colon = scheme(1)
        if (colon < len(t) && t[colon] == ":") { return lower(t[:colon]) }
    }
    val slash = fn(c:str):bool { c == "/" || c == "\\" }
    if (len(t) >= 2 && slash(t[0]) && slash(t[1])) { "network" } else { "relative" }
}

val allowed = fn(kind:str, schemes:map):bool {
    if (kind == "") { return false }
    if (kind == "network") { return schemes["http"] == true && schemes["https"] == true }
    schemes[kind] == true
}

val HEX = "0123456789ABCDEF"

val HREF_SAFE = {
    "-": true, "_": true, ".": true, "+": true, "!": true, "*": true, "(": true, ")": true, ",": true,
    "%": true, "#": true, "@": true, "?": true, "=": true, ";": true, ":": true, "/": true, "$": true,
    "~": true,
}

// `url` as an attribute value: percent-encoded outside a safe set, with `&`
// and `'` escaped.
val escapeHref = fn(url:str):str {
    val encode = fn(c:str):str {
        val bytes = toBytes(c)
        val go = fn(i:num, out:str):str {
            if (i >= len(bytes)) { return out }
            val b = bytes[i]
            recur(i + 1, out + "%" + HEX[b >> 4] + HEX[b & 15])
        }
        go(0, "")
    }
    val go = fn(i:num, out:str):str {
        if (i >= len(url)) { return out }
        val c = url[i]
        val piece = if (isAlnum(c) || HREF_SAFE[c] == true) {
            c
        } else if (c == "&") {
            "&amp;"
        } else if (c == "'") {
            "&#x27;"
        } else {
            encode(c)
        }
        recur(i + 1, out + piece)
    }
    go(0, "")
}

// --- HTML --------------------------------------------------------------------

val ESCAPES = {"&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;"}

val ESCAPED = toBytes("&<>\"")

val escape = fn(text:str):str {
    if (bytes.findAny(toBytes(text), ESCAPED) == nil) { return text }
    val go = fn(i:num, start:num, out:str):str {
        if (i >= len(text)) { return if (start == 0) { text } else { out + text[start:] } }
        val e = ESCAPES[text[i]]
        if (e == nil) { recur(i + 1, start, out) } else { recur(i + 1, i + 1, out + text[start:i] + e) }
    }
    go(0, 0, "")
}

// The text of inline nodes, for an image's description.
val plainText = fn(nodes:list):str {
    val go = fn(i:num, out:str):str {
        if (i >= len(nodes)) { return out }
        val node = nodes[i]
        val kind = node.type
        val text = if (kind == "text" || kind == "code" || kind == "html") {
            node.text
        } else if (kind == "softbreak" || kind == "hardbreak") {
            " "
        } else {
            plainText(node.children ?? [])
        }
        recur(i + 1, out + text)
    }
    go(0, "")
}

val firstWord = fn(text:str):str {
    val go = fn(i:num):num {
        if (i < len(text) && text[i] != " " && text[i] != "\t" && text[i] != "\n") { recur(i + 1) } else { i }
    }
    text[:go(0)]
}

val renderHtml = fn(document:map, refs:map, o:map, maxOutputBytes:num|nil = nil):str {
    var out = []
    var atLineStart = true
    var outputBytes = 0

    val emit = fn(text:str) {
        if (text != "") {
            if (maxOutputBytes != nil) {
                outputBytes = outputBytes + len(toBytes(text))
                if (outputBytes > maxOutputBytes) {
                    throw Error {type: "markdown.limit", msg: "rendered HTML exceeds output limit", data: {limit: "outputBytes", max: maxOutputBytes}}
                }
            }
            out = out :+ text
            atLineStart = text[len(text) - 1] == "\n"
        }
    }
    val cr = fn() { if (!atLineStart) { emit("\n") } }

    val inlines = fn(text:str):list { parseInlines(text, refs, o.maxDepth) }

    val renderInlines = fn(nodes:list, inLink:bool) {
        val each = fn(i:num) {
            if (i >= len(nodes)) { return nil }
            val node = nodes[i]
            val kind = node.type
            if (kind == "text" || kind == "html") {
                emit(escape(node.text))
            } else if (kind == "softbreak") {
                emit("\n")
            } else if (kind == "hardbreak") {
                emit("<br />\n")
            } else if (kind == "code") {
                emit("<code>" + escape(node.text) + "</code>")
            } else if (kind == "emph" || kind == "strong" || kind == "del") {
                emit("<" + (if (kind == "emph") { "em" } else { kind }) + ">")
                renderInlines(node.children, inLink)
                emit("</" + (if (kind == "emph") { "em" } else { kind }) + ">")
            } else if (kind == "link") {
                val kind = urlKind(node.url)
                if (inLink || !allowed(kind, o.links)) {
                    renderInlines(node.children, inLink)
                } else {
                    val title = if (node.title == "") { "" } else { " title=\"" + escape(node.title) + "\"" }
                    val rel = if (o.rel == "" || kind == "relative") { "" } else { " rel=\"" + o.rel + "\"" }
                    emit("<a href=\"" + escapeHref(node.url) + "\"" + title + rel + ">")
                    renderInlines(node.children, true)
                    emit("</a>")
                }
            } else if (kind == "image") {
                val description = escape(plainText(node.children))
                if (allowed(urlKind(node.url), o.images)) {
                    val title = if (node.title == "") { "" } else { " title=\"" + escape(node.title) + "\"" }
                    emit("<img src=\"" + escapeHref(node.url) + "\" alt=\"" + description + "\"" + title + " />")
                } else {
                    emit(description)
                }
            }
            recur(i + 1)
        }
        each(0)
    }

    val renderCells = fn(cells:list, columns:list, tag:str, parsed:bool = false) {
        val each = fn(i:num) {
            if (i < len(columns)) {
                val align = columns[i]
                emit(if (align == "") { "<$tag>" } else { "<$tag align=\"$align\">" })
                if (i < len(cells)) { renderInlines(if (parsed) { cells[i] } else { inlines(cells[i]) }, false) }
                emit("</$tag>\n")
                recur(i + 1)
            }
        }
        emit("<tr>\n")
        each(0)
        emit("</tr>\n")
    }

    val renderBlocks = fn(blocks:list, tight:bool) {
        val each = fn(i:num) {
            if (i >= len(blocks)) { return nil }
            val block = blocks[i]
            val kind = block.type
            if (kind == "paragraph") {
                if (tight) {
                    renderInlines(block.inlines ?? inlines(block.text), false)
                } else {
                    cr()
                    emit("<p>")
                    renderInlines(block.inlines ?? inlines(block.text), false)
                    emit("</p>\n")
                }
            } else if (kind == "heading") {
                cr()
                emit("<h${block.level}" + (if (block.id == nil) { "" } else { " id=\"" + escape(block.id) + "\"" }) + ">")
                renderInlines(block.inlines ?? inlines(block.text), false)
                emit("</h${block.level}>\n")
            } else if (kind == "blockquote") {
                cr()
                emit("<blockquote>\n")
                renderBlocks(block.children, false)
                cr()
                emit("</blockquote>\n")
            } else if (kind == "list") {
                cr()
                val tag = if (block.ordered) { "ol" } else { "ul" }
                emit(if (block.ordered && block.start != 1) { "<ol start=\"${block.start}\">\n" } else { "<$tag>\n" })
                renderBlocks(block.children, block.tight)
                emit("</$tag>\n")
            } else if (kind == "item") {
                cr()
                emit("<li>")
                renderBlocks(block.children, tight)
                emit("</li>\n")
            } else if (kind == "code") {
                cr()
                val language = firstWord(block.info)
                emit(if (language == "") { "<pre><code>" } else { "<pre><code class=\"language-" + escape(language) + "\">" })
                emit(escape(block.text))
                emit("</code></pre>\n")
            } else if (kind == "thematic") {
                cr()
                emit("<hr />\n")
            } else if (kind == "table") {
                cr()
                emit("<table>\n<thead>\n")
                renderCells(block.head, block.aligns, "th", block.parsedCells == true)
                emit("</thead>\n")
                if (len(block.rows) > 0) {
                    emit("<tbody>\n")
                    val rows = fn(j:num) {
                        if (j < len(block.rows)) {
                            renderCells(block.rows[j], block.aligns, "td", block.parsedCells == true)
                            recur(j + 1)
                        }
                    }
                    rows(0)
                    emit("</tbody>\n")
                }
                emit("</table>\n")
            }
            recur(i + 1)
        }
        each(0)
    }

    renderBlocks(document.children, false)
    join(out, "")
}

// --- Source ------------------------------------------------------------------

val replaceAll = fn(text:str, from:str, to:str):str { join(split(text, from), to) }

// `source` with `\n` line endings, one at its end, and U+FFFD for NUL.
val normalize = fn(source:str):str {
    val lines = replaceAll(replaceAll(replaceAll(source, "\r\n", "\n"), "\r", "\n"), "\0", "�")
    if (lines == "" || lines[len(lines) - 1] == "\n") { lines } else { lines + "\n" }
}

/**
 * Renders the Markdown `source` as an HTML fragment, under `options` (see
 * the module's documentation). Throws `markdown.options` for bad options and
 * `markdown.limit` for source over the size or nesting limits.
 */
export val toHtml = fn(source:str, options:map = {}):str {
    val o = checkOptions(options)
    val bytes = len(toBytes(source))
    if (bytes > o.maxBytes) {
        throw Error {
            type: "markdown.limit",
            msg: "the source is $bytes bytes, over the limit of ${o.maxBytes}",
            data: {limit: "bytes", max: o.maxBytes},
        }
    }
    val parsed = parseBlocks(normalize(source), o.maxDepth)
    renderHtml(parsed.document, parsed.refs, o)
}

/**
 * Renders a typed document; validates structure, provenance, and budgets.
 */
export val render = fn(document:Document, options:map = {}):str {
    val o = documentSettings(options, true)
    val defaults:map = {links: DEFAULTS.links, images: DEFAULTS.images, rel: DEFAULTS.rel, maxDepth: o.maxDepth, maxBytes: o.maxBytes}
    val policy = checkOptions((defaults + options) - "maxNodes" - "maxOutputBytes")
    renderHtml(lowerDocument(document, o), {}, policy, o.maxOutputBytes)
}

// --- Typed documents ----------------------------------------------------------

export type Position = {offset:num, line:num, column:num}
export type Span = {start:Position, end:Position}
export type Document = {children:list<Node>, span:Span|nil}

export val Position = struct {offset:num, line:num, column:num}
export val Span = struct {start:Position, end:Position}

export enum Node {
    Text {text:str, span:Span|nil = nil}
    CodeSpan {text:str, span:Span|nil = nil}
    RawHtml {text:str, span:Span|nil = nil}
    SoftBreak {span:Span|nil = nil}
    HardBreak {span:Span|nil = nil}
    ThematicBreak {span:Span|nil = nil}
    Emphasis {children:list<Node>, span:Span|nil = nil}
    Strong {children:list<Node>, span:Span|nil = nil}
    Strikethrough {children:list<Node>, span:Span|nil = nil}
    Link {url:str, children:list<Node>, title:str = "", definition:Span|nil = nil, span:Span|nil = nil}
    Image {url:str, children:list<Node>, title:str = "", definition:Span|nil = nil, span:Span|nil = nil}
    Paragraph {children:list<Node>, span:Span|nil = nil}
    Heading {level:num, children:list<Node>, id:str|nil = nil, span:Span|nil = nil}
    CodeBlock {text:str, info:str = "", span:Span|nil = nil}
    BlockQuote {children:list<Node>, span:Span|nil = nil}
    Item {children:list<Node>, span:Span|nil = nil}
    List {children:list<Node>, ordered:bool = false, start:num = 1, tight:bool = false, span:Span|nil = nil}
    Table {aligns:list<str>, head:list<list<Node>>, rows:list<list<list<Node>>>, span:Span|nil = nil}
}

export val Document = struct {children:list<Node>, span:Span|nil = nil}

val fail = fn(message:str) { throw Error {type: "markdown.document", msg: message} }
val limit = fn(kind:str, max:num) {
    throw Error {type: "markdown.limit", msg: "document exceeds $kind limit $max", data: {limit: kind, max: max}}
}
val whole = fn(n:num):bool { n >= 0 && n <= 9223372036854775807 && int(n) == n }

// Shared by the public wrappers. Policy options are validated by markdown's
// renderer; these are the independent source/tree/output budgets.
val documentSettings = fn(options:map, rendering:bool = false):map {
    val defaults:map = {maxBytes: 65536, maxDepth: 32, maxNodes: 65536}
    val allowed = if (rendering) { defaults + {maxOutputBytes: 1048576, links: [], images: [], rel: ""} } else { defaults }
    val names = keys(options)
    val each = fn(i:num) {
        if (i < len(names)) {
            val name = names[i]
            if (allowed[name] == nil) { throw Error {type: "markdown.options", msg: "unknown option `$name`"} }
            if (name != "links" && name != "images" && name != "rel") {
                val valid = match options[name] { n:num => whole(n) && n > 0; _ => false }
                if (!valid) { throw Error {type: "markdown.options", msg: "`$name` must be a positive integer"} }
            }
            recur(i + 1)
        }
    }
    each(0)
    (if (rendering) { defaults + {maxOutputBytes: 1048576} } else { defaults }) + options
}

val checkSpan = fn(span:Span|nil) {
    if (span == nil) { return nil }
    val a = span.start
    val b = span.end
    val valid = fn(p:Position):bool { whole(p.offset) && whole(p.line) && p.line > 0 && whole(p.column) && p.column > 0 }
    if (!valid(a) || !valid(b) || b.offset < a.offset || b.line < a.line
        || (a.line == b.line && b.column - a.column != b.offset - a.offset)
        || (a.offset == b.offset && (a.line != b.line || a.column != b.column))) {
        fail("invalid source span")
    }
}

// Normalize while keeping a boundary position for every normalized scalar.
// The synthetic final newline maps to EOF, not beyond the original source.
val sourceMap = fn(source:str):map {
    val go = fn(i:num, line:num, column:num, text:list<str>, positions:list):map {
        val position = Position {offset: i, line: line, column: column}
        if (i >= len(source)) {
            val trailing = len(text) > 0 && text[len(text) - 1] == "\n"
            {text: join(if (trailing) { text } else { text :+ "\n" }, ""), positions: if (trailing) { positions :+ position } else { positions + [position, position] }}
        } else {
            val c = source[i]
            if (c == "\r") {
                val step = if (i + 1 < len(source) && source[i + 1] == "\n") { 2 } else { 1 }
                recur(i + step, line + 1, 1, text :+ "\n", positions :+ position)
            } else if (c == "\n") {
                recur(i + 1, line + 1, 1, text :+ c, positions :+ position)
            } else {
                recur(i + 1, line, column + 1, text :+ (if (c == "\0") { "�" } else { c }), positions :+ position)
            }
        }
    }
    go(0, 1, 1, [], [])
}

/**
 * Parses a complete typed document with original-source spans and resolved
 * references, under source-byte, nesting, and node limits.
 */
export val parse = fn(source:str, options:map = {}):Document {
    val o = documentSettings(options)
    if (len(source) > o.maxBytes || len(toBytes(source)) > o.maxBytes) { limit("bytes", o.maxBytes) }
    val normalized = sourceMap(source)
    val parsed = parseBlocks(normalized.text, o.maxDepth, true)
    var count = 0
    val tick = fn() { count = count + 1; if (count > o.maxNodes) { limit("nodes", o.maxNodes) } }
    val spanAt = fn(start:num, end:num):Span { Span {start: normalized.positions[start], end: normalized.positions[end]} }
    val location = fn(raw:map):Span|nil {
        if (raw.sourceStart == nil || raw.sourceEnd == nil) { nil } else { spanAt(raw.sourceStart, raw.sourceEnd) }
    }
    val inlineNodes = fn(text:str, positions:list):list<Node> {
        fromInlines(parseInlines(text, parsed.refs, o.maxDepth, positions))
    }
    val fromInlines = fn(raw:list):list<Node> {
        val go = fn(i:num, out:list<Node>):list<Node> {
            if (i >= len(raw)) { return out }
            tick()
            val n = raw[i]
            val span = location(n)
            val node:Node = if (n.type == "text") { Node.Text {text: n.text, span: span} }
                else if (n.type == "html") { Node.RawHtml {text: n.text, span: span} }
                else if (n.type == "code") { Node.CodeSpan {text: n.text, span: span} }
                else if (n.type == "softbreak") { Node.SoftBreak {span: span} }
                else if (n.type == "hardbreak") { Node.HardBreak {span: span} }
                else if (n.type == "emph") { Node.Emphasis {children: fromInlines(n.children), span: span} }
                else if (n.type == "strong") { Node.Strong {children: fromInlines(n.children), span: span} }
                else if (n.type == "del") { Node.Strikethrough {children: fromInlines(n.children), span: span} }
                else {
                    val definition = if (n.definitionStart == nil) { nil } else { spanAt(n.definitionStart, n.definitionEnd) }
                    if (n.type == "link") { Node.Link {url: n.url, title: n.title, children: fromInlines(n.children), span: span, definition: definition} }
                    else { Node.Image {url: n.url, title: n.title, children: fromInlines(n.children), span: span, definition: definition} }
                }
            recur(i + 1, out :+ node)
        }
        go(0, [])
    }
    val cells = fn(texts:list, positions:list, width:num):list<list<Node>> {
        val go = fn(i:num, out:list<list<Node>>):list<list<Node>> {
            if (i >= width) { return out }
            tick()
            val cell = if (i < len(texts)) { inlineNodes(texts[i], positions[i]) } else { [] }
            recur(i + 1, out :+ cell)
        }
        go(0, [])
    }
    val blocks = fn(raw:list):list<Node> {
        val go = fn(i:num, out:list<Node>):list<Node> {
            if (i >= len(raw)) { return out }
            tick()
            val n = raw[i]
            val span = location(n)
            val node:Node = if (n.type == "paragraph") { Node.Paragraph {children: inlineNodes(n.text, n.positions), span: span} }
                else if (n.type == "heading") { Node.Heading {level: n.level, children: inlineNodes(n.text, n.positions), span: span} }
                else if (n.type == "code") { Node.CodeBlock {info: n.info, text: n.text, span: span} }
                else if (n.type == "thematic") { Node.ThematicBreak {span: span} }
                else if (n.type == "blockquote") { Node.BlockQuote {children: blocks(n.children), span: span} }
                else if (n.type == "item") { Node.Item {children: blocks(n.children), span: span} }
                else if (n.type == "list") { Node.List {ordered: n.ordered, start: n.start, tight: n.tight, children: blocks(n.children), span: span} }
                else {
                    val rows = fn(j:num, out:list<list<list<Node>>>):list<list<list<Node>>> {
                        if (j >= len(n.rows)) { return out }
                        tick()
                        recur(j + 1, out :+ cells(n.rows[j], n.rowPositions[j], len(n.aligns)))
                    }
                    Node.Table {aligns: n.aligns, head: cells(n.head, n.headPositions, len(n.aligns)), rows: rows(0, []), span: span}
                }
            recur(i + 1, out :+ node)
        }
        go(0, [])
    }
    Document {children: blocks(parsed.document.children), span: Span {start: normalized.positions[0], end: normalized.positions[len(normalized.positions) - 1]}}
}

// Validate categories and budgets while lowering into the renderer's private
// maps. Nominal enums alone cannot prevent an inline block or out-of-range h7.
val lowerDocument = fn(document:Document, o:map):map {
    var count = 0
    var size = 0
    val tick = fn() { count = count + 1; if (count > o.maxNodes) { limit("nodes", o.maxNodes) } }
    val text = fn(value:str):str {
        if (len(value) > o.maxBytes - size) { limit("bytes", o.maxBytes) }
        size = size + len(toBytes(value))
        if (size > o.maxBytes) { limit("bytes", o.maxBytes) }
        value
    }
    val sequence = fn(nodes:list<Node>, category:str, blocks:num, inlines:num):list<map> {
        val go = fn(i:num, out:list<map>):list<map> {
            if (i >= len(nodes)) { out } else { recur(i + 1, out :+ node(nodes[i], category, blocks, inlines)) }
        }
        go(0, [])
    }
    val node = fn(value:Node, category:str, blocks:num, inlines:num):map {
        tick()
        if (blocks > o.maxDepth || inlines > o.maxDepth) { limit("depth", o.maxDepth) }
        val raw:map = match value {
            n:Node.Text => {
                if (category != "inline") { fail("inline node in a block sequence") }
                checkSpan(n.span)
                {type: "text", text: text(n.text)}
            }
            n:Node.CodeSpan => {
                if (category != "inline") { fail("inline node in a block sequence") }
                checkSpan(n.span)
                {type: "code", text: text(n.text)}
            }
            n:Node.RawHtml => {
                if (category != "inline") { fail("inline node in a block sequence") }
                checkSpan(n.span)
                {type: "html", text: text(n.text)}
            }
            n:Node.SoftBreak => {
                if (category != "inline") { fail("inline node in a block sequence") }
                checkSpan(n.span)
                {type: "softbreak"}
            }
            n:Node.HardBreak => {
                if (category != "inline") { fail("inline node in a block sequence") }
                checkSpan(n.span)
                {type: "hardbreak"}
            }
            n:Node.Emphasis => {
                if (category != "inline") { fail("inline node in a block sequence") }
                if (inlines + 1 > o.maxDepth) { limit("depth", o.maxDepth) }
                checkSpan(n.span)
                {type: "emph", children: sequence(n.children, "inline", blocks, inlines + 1)}
            }
            n:Node.Strong => {
                if (category != "inline") { fail("inline node in a block sequence") }
                if (inlines + 1 > o.maxDepth) { limit("depth", o.maxDepth) }
                checkSpan(n.span)
                {type: "strong", children: sequence(n.children, "inline", blocks, inlines + 1)}
            }
            n:Node.Strikethrough => {
                if (category != "inline") { fail("inline node in a block sequence") }
                if (inlines + 1 > o.maxDepth) { limit("depth", o.maxDepth) }
                checkSpan(n.span)
                {type: "del", children: sequence(n.children, "inline", blocks, inlines + 1)}
            }
            n:Node.Link => {
                if (category != "inline") { fail("inline node in a block sequence") }
                if (inlines + 1 > o.maxDepth) { limit("depth", o.maxDepth) }
                checkSpan(n.span)
                checkSpan(n.definition)
                {type: "link", children: sequence(n.children, "inline", blocks, inlines + 1), url: text(n.url), title: text(n.title)}
            }
            n:Node.Image => {
                if (category != "inline") { fail("inline node in a block sequence") }
                if (inlines + 1 > o.maxDepth) { limit("depth", o.maxDepth) }
                checkSpan(n.span)
                checkSpan(n.definition)
                {type: "image", children: sequence(n.children, "inline", blocks, inlines + 1), url: text(n.url), title: text(n.title)}
            }
            n:Node.Paragraph => {
                if (category != "block") { fail("block node in the wrong sequence") }
                checkSpan(n.span)
                {type: "paragraph", inlines: sequence(n.children, "inline", blocks, 0)}
            }
            n:Node.Heading => {
                if (category != "block") { fail("block node in the wrong sequence") }
                checkSpan(n.span)
                if (!whole(n.level) || n.level < 1 || n.level > 6) { fail("heading level must be from 1 through 6") }
                if (n.id != nil) {
                    if (n.id == "") { fail("heading ID must not be empty") }
                    val valid = fn(i:num):bool { if (i >= len(n.id)) { true } else if (n.id[i] <= " " || n.id[i] == "\x7f") { false } else { recur(i + 1) } }
                    if (!valid(0)) { fail("heading ID contains whitespace or a control character") }
                    text(n.id)
                }
                {type: "heading", inlines: sequence(n.children, "inline", blocks, 0), level: n.level, id: n.id}
            }
            n:Node.CodeBlock => {
                if (category != "block") { fail("block node in the wrong sequence") }
                checkSpan(n.span)
                {type: "code", text: text(n.text), info: text(n.info)}
            }
            n:Node.ThematicBreak => {
                if (category != "block") { fail("block node in the wrong sequence") }
                checkSpan(n.span)
                {type: "thematic"}
            }
            n:Node.BlockQuote => {
                if (category != "block") { fail("block node in the wrong sequence") }
                if (blocks + 1 > o.maxDepth) { limit("depth", o.maxDepth) }
                checkSpan(n.span)
                {type: "blockquote", children: sequence(n.children, "block", blocks + 1, 0)}
            }
            n:Node.Item => {
                if (category != "item") { fail("block node in the wrong sequence") }
                if (blocks + 1 > o.maxDepth) { limit("depth", o.maxDepth) }
                checkSpan(n.span)
                {type: "item", children: sequence(n.children, "block", blocks + 1, 0)}
            }
            n:Node.List => {
                if (category != "block") { fail("block node in the wrong sequence") }
                if (blocks + 1 > o.maxDepth) { limit("depth", o.maxDepth) }
                checkSpan(n.span)
                if (!whole(n.start) || n.start > 999999999) { fail("list start must be an integer from 0 through 999999999") }
                {type: "list", children: sequence(n.children, "item", blocks + 1, 0), ordered: n.ordered, start: n.start, tight: n.tight}
            }
            n:Node.Table => {
                if (category != "block") { fail("table in a non-block sequence") }
                checkSpan(n.span)
                val width = len(n.aligns)
                if (width < 1) { fail("table must have a column") }
                if (width > o.maxNodes - count) { limit("nodes", o.maxNodes) }
                val aligns = map(n.aligns, fn(align:str):str {
                    if (align != "" && align != "left" && align != "center" && align != "right") { fail("invalid table alignment") }
                    text(align)
                })
                val cells = fn(row:list<list<Node>>):list {
                    if (len(row) != width) { fail("table row width does not match its columns") }
                    map(row, fn(cell:list<Node>):list { tick(); sequence(cell, "inline", blocks, 0) })
                }
                {type: "table", aligns: aligns, head: cells(n.head), rows: map(n.rows, fn(row:list<list<Node>>):list { tick(); cells(row) }), parsedCells: true}
            }
        }
        raw
    }
    checkSpan(document.span)
    {children: sequence(document.children, "block", 0, 0)}
}

/**
 * Replaces each original node once, children first. Validates the input and
 * result; replacement children are not visited and callback errors propagate.
 */
export val transform = fn(document:Document, rewrite:fn<Node, Node>, options:map = {}):Document {
    val o = documentSettings(options)
    lowerDocument(document, o)
    val visit = fn(node:Node):Node {
        val updated:Node = match node {
            n:Node.Emphasis => n copy {children: map(n.children, visit)}
            n:Node.Strong => n copy {children: map(n.children, visit)}
            n:Node.Strikethrough => n copy {children: map(n.children, visit)}
            n:Node.Link => n copy {children: map(n.children, visit)}
            n:Node.Image => n copy {children: map(n.children, visit)}
            n:Node.Paragraph => n copy {children: map(n.children, visit)}
            n:Node.Heading => n copy {children: map(n.children, visit)}
            n:Node.BlockQuote => n copy {children: map(n.children, visit)}
            n:Node.Item => n copy {children: map(n.children, visit)}
            n:Node.List => n copy {children: map(n.children, visit)}
            n:Node.Table => n copy {
                head: map(n.head, fn(cell:list<Node>):list<Node> { map(cell, visit) }),
                rows: map(n.rows, fn(row:list<list<Node>>):list<list<Node>> { map(row, fn(cell:list<Node>):list<Node> { map(cell, visit) }) }),
            }
            _ => node
        }
        rewrite(updated)
    }
    val result = document copy {children: map(document.children, visit)}
    lowerDocument(result, o)
    result
}

/**
 * Extracts decoded text, code, and image descriptions, with newlines between
 * blocks and tabs between table cells. Does not add URLs or HTML escapes.
 */
export val toText = fn(document:Document, options:map = {}):str {
    val o = documentSettings(options)
    val raw = lowerDocument(document, o)
    var output:list<str> = []
    var size = 0
    val emit = fn(text:str) {
        size = size + len(toBytes(text))
        if (size > o.maxBytes) { limit("bytes", o.maxBytes) }
        output = output :+ text
    }
    val inline = fn(nodes:list) {
        val go = fn(i:num) {
            if (i >= len(nodes)) { return nil }
            val n = nodes[i]
            if (n.type == "text" || n.type == "html" || n.type == "code") { emit(n.text) }
            else if (n.type == "softbreak" || n.type == "hardbreak") { emit("\n") }
            else { inline(n.children) }
            recur(i + 1)
        }
        go(0)
    }
    val blocks = fn(nodes:list) {
        val go = fn(i:num) {
            if (i >= len(nodes)) { return nil }
            if (i > 0) { emit("\n") }
            val n = nodes[i]
            if (n.type == "paragraph" || n.type == "heading") { inline(n.inlines) }
            else if (n.type == "code") { emit(n.text) }
            else if (n.type == "table") {
                val row = fn(cells:list) {
                    val each = fn(j:num) { if (j < len(cells)) { if (j > 0) { emit("\t") }; inline(cells[j]); recur(j + 1) } }
                    each(0)
                }
                row(n.head)
                val rows = fn(j:num) { if (j < len(n.rows)) { emit("\n"); row(n.rows[j]); recur(j + 1) } }
                rows(0)
            } else if (n.type != "thematic") { blocks(n.children) }
            recur(i + 1)
        }
        go(0)
    }
    blocks(raw.children)
    join(output, "")
}
